# Binary payloads are part of the x86QW distribution and live in Git LFS.
dist/** -diff -merge -text
dist/**/*.AppImage filter=lfs diff=lfs merge=lfs -text
dist/**/*.bsp filter=lfs diff=lfs merge=lfs -text
dist/**/*.exe filter=lfs diff=lfs merge=lfs -text
dist/**/*.gz filter=lfs diff=lfs merge=lfs -text
dist/**/*.pak filter=lfs diff=lfs merge=lfs -text
dist/**/*.PAK filter=lfs diff=lfs merge=lfs -text
dist/**/*.pk3 filter=lfs diff=lfs merge=lfs -text
dist/**/*.qvm filter=lfs diff=lfs merge=lfs -text
dist/**/*.mvd filter=lfs diff=lfs merge=lfs -text
dist/**/*.zip filter=lfs diff=lfs merge=lfs -text
dist/servers/**/x86qw/runtime/** filter=lfs diff=lfs merge=lfs -text
dist/services/**/x86qw/runtime/** filter=lfs diff=lfs merge=lfs -text

# Project-authored metadata and overlays remain reviewable as text.
dist/manifest.json diff merge text
dist/installer/VERSION diff merge text eol=lf
dist/installer/**/*.py diff merge text eol=lf
dist/installer/**/*.md diff merge text
dist/installer/**/*.sh diff merge text eol=lf
dist/installer/**/*.ps1 diff merge text eol=lf
dist/installer/bin/x86qw diff merge text
dist/installer/**/*.cmd diff merge text
dist/mods/**/*.cfg diff merge text
dist/mods/**/*.example diff merge text
dist/mods/**/*.json diff merge text
dist/mods/**/*.md diff merge text
dist/mods/**/*.patch diff merge text
dist/mods/**/x86qw/source/*.patch whitespace=-blank-at-eol,-space-before-tab
dist/mods/**/x86qw/runtime/qwprogs.map filter=lfs diff=lfs merge=lfs -text

# Generated public contracts are byte-compared by verify on every platform.
site/public/api/v1/*.json text eol=lf
site/public/install.sh text eol=lf
site/public/install.ps1 text eol=lf
x86qw_runtime/io/archive.py text eol=lf
