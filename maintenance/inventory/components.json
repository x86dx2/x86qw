  "components": [
    {
      "id": "nquake-bootstrap",
      "label": "Configuração base nQuake",
      "kind": "core",
      "description": "Inicialização, configuração padrão preservável, fragfile e exemplos de configuração.",
      "requires": [],
      "sources": [
        {"path": "gpl/ezquake/configs", "destination": "ezquake/configs", "mode": "overlay", "exclude": ["gpl/ezquake/configs/config.cfg"]},
        {"path": "gpl/ezquake/configs/config.cfg", "destination": "ezquake/configs/config.cfg", "mode": "default"},
        {"path": "non-gpl/qw/autoexec.cfg", "destination": "qw/autoexec.cfg", "mode": "overlay"},
        {"path": "non-gpl/qw/nquake_default.cfg", "destination": "qw/nquake_default.cfg", "mode": "overlay"},
        {"path": "non-gpl/qw/fragfile.dat", "destination": "qw/fragfile.dat", "mode": "overlay"}
      ]
    },
    {
      "id": "nquake-visual-core",
