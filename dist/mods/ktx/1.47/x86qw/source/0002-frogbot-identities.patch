+#define FROGBOT_NAME_ROLES 3
+#define FROGBOT_ROLE_GENERIC 0
+#define FROGBOT_ROLE_FRIENDLY 1
+#define FROGBOT_ROLE_ENEMY 2
+
+static char cached_bot_names[FROGBOT_NAME_ROLES][MAX_CLIENTS][64];
+
+static const char* FrogbotNameSuffix(int role)
+{
+	switch (role)
+	{
+		case FROGBOT_ROLE_FRIENDLY: return "_team";
+		case FROGBOT_ROLE_ENEMY: return "_enemy";
+		default: return "";
+	}
+}
+
+void FrogbotCacheNames(void)
+{
+	int role, botNumber;
+
+	for (role = 0; role < FROGBOT_NAME_ROLES; ++role)
+	{
+		const char *suffix = FrogbotNameSuffix(role);
+
+		for (botNumber = 0; botNumber < MAX_CLIENTS; ++botNumber)
+		{
+			const char *name = cvar_string(va("k_fb_name%s_%d", suffix, botNumber));
+
+			if (!strnull(name))
+			{
+				strlcpy(cached_bot_names[role][botNumber], name,
+						sizeof(cached_bot_names[role][botNumber]));
+			}
+		}
+	}
+}
+
+static char* FrogbotCachedName(int role, int botNumber)
+{
+	return cached_bot_names[role][(int)bound(0, botNumber, MAX_CLIENTS - 1)];
+}
