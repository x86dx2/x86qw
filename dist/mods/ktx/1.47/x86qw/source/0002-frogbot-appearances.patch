+#define FROGBOT_APPEARANCE_ROLES 3
+#define FROGBOT_ROLE_GENERIC 0
+#define FROGBOT_ROLE_FRIENDLY 1
+#define FROGBOT_ROLE_ENEMY 2
+
+static char cached_bot_names[FROGBOT_APPEARANCE_ROLES][MAX_CLIENTS][64];
+static int cached_bot_topcolors[FROGBOT_APPEARANCE_ROLES][MAX_CLIENTS];
+static int cached_bot_bottomcolors[FROGBOT_APPEARANCE_ROLES][MAX_CLIENTS];
+static qbool cached_bot_colors[FROGBOT_APPEARANCE_ROLES][MAX_CLIENTS];
+
+static const char* FrogbotAppearanceSuffix(int role)
+{
+	switch (role)
+	{
+		case FROGBOT_ROLE_FRIENDLY: return "_team";
+		case FROGBOT_ROLE_ENEMY: return "_enemy";
+		default: return "";
+	}
+}
+
+void FrogbotCacheAppearances(void)
+{
+	int role, botNumber;
+
+	for (role = 0; role < FROGBOT_APPEARANCE_ROLES; ++role)
+	{
+		const char *suffix = FrogbotAppearanceSuffix(role);
+
+		for (botNumber = 0; botNumber < MAX_CLIENTS; ++botNumber)
+		{
+			const char *name = cvar_string(va("k_fb_name%s_%d", suffix, botNumber));
+			const char *top = cvar_string(va("k_fb_topcolor%s_%d", suffix, botNumber));
+			const char *bottom = cvar_string(va("k_fb_bottomcolor%s_%d", suffix, botNumber));
+
+			if (!strnull(name))
+			{
+				strlcpy(cached_bot_names[role][botNumber], name,
+						sizeof(cached_bot_names[role][botNumber]));
+			}
+			if (!strnull(top) && !strnull(bottom))
+			{
+				cached_bot_topcolors[role][botNumber] = bound(0, atoi(top), 13);
+				cached_bot_bottomcolors[role][botNumber] = bound(0, atoi(bottom), 13);
+				cached_bot_colors[role][botNumber] = true;
+			}
+		}
+	}
+}
+
+static char* FrogbotCachedName(int role, int botNumber)
+{
+	return cached_bot_names[role][(int)bound(0, botNumber, MAX_CLIENTS - 1)];
+}
+
+static qbool FrogbotCachedColors(int role, int botNumber, int *topColor, int *bottomColor)
+{
+	botNumber = bound(0, botNumber, MAX_CLIENTS - 1);
+	if (!cached_bot_colors[role][botNumber])
+	{
+		return false;
+	}
+	*topColor = cached_bot_topcolors[role][botNumber];
+	*bottomColor = cached_bot_bottomcolors[role][botNumber];
+	return true;
+}
+
+qbool BotColorsGeneric(int botNumber, int *topColor, int *bottomColor)
+{
+	return FrogbotCachedColors(FROGBOT_ROLE_GENERIC, botNumber, topColor, bottomColor);
+}
+
+qbool BotColorsFriendly(int botNumber, int *topColor, int *bottomColor)
+{
+	return FrogbotCachedColors(FROGBOT_ROLE_FRIENDLY, botNumber, topColor, bottomColor);
+}
+
+qbool BotColorsEnemy(int botNumber, int *topColor, int *bottomColor)
+{
+	return FrogbotCachedColors(FROGBOT_ROLE_ENEMY, botNumber, topColor, bottomColor);
+}
