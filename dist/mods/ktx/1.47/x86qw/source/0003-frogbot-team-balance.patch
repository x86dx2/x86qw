+static int FrogbotAutomaticTeamCount(void)
+{
+	return current_umode >= um2on2on2 && current_umode <= um4on4on4 ? 3 : 2;
+}
+
+static team_t* FrogbotLeastPopulatedTeam(int teamCount)
+{
+	team_t *selected = &teams[0];
+	int selectedCount = selected->humans + selected->bots;
+	int i;
+
+	for (i = 1; i < teamCount; ++i)
+	{
+		int candidateCount = teams[i].humans + teams[i].bots;
+		if (candidateCount < selectedCount)
+		{
+			selected = &teams[i];
+			selectedCount = candidateCount;
+		}
+	}
+
+	return selected;
+}
