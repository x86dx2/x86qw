+# Assignment
+
+- assignment_id:
+- gate:
+- operational_role: Bootstrap Qualifier | Orchestrator | Maker | Checker externo
+- objective:
+- baseline_sha:
+- branch:
+- cwd/worktree:
+- allowlist:
+- non_scope:
+- dependencies:
