/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff

/assets/fonts/*
  Cache-Control: public, max-age=604800, must-revalidate

/assets/social-card.png
  Cache-Control: public, max-age=604800, must-revalidate

/assets/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate

/assets/favicon-32.png
  Cache-Control: public, max-age=604800, must-revalidate

/assets/site.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate

/install.sh
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/install.ps1
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store

/api/v1/catalog.json
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/product.json
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/release-truth.json
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/version
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/version
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/health
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/trust/metadata/*
  Cache-Control: no-store, no-cache, must-revalidate
  CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/api/v1/trust/targets/*
  Cache-Control: public, max-age=31536000, immutable
